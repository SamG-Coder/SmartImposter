#version 460
#extension GL_GOOGLE_include_directive : require
#ifdef SER
#extension GL_NV_shader_invocation_reorder : require
#endif
#include "rt.glsl"
#include "atmosphere.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D depthImg;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D curImg;
layout(set = 0, binding = 3) uniform GlobalsUBO { Globals g; };
#include "clouds.glsl"
#include "aircraft.glsl"

// ---- the sea's waves (globe/ocean.rs): CASCADES FFT patches, texture A = (Dx, h, Dz, foam),
// B = (dh/dx, dh/dz, dDx/dx, dDz/dz) per cascade, in patch coordinates along the water's (u, v)
layout(set = 0, binding = 33) uniform sampler2D oceanTex[8];
const float OSIZE[4] = float[4](1024.0, 256.0, 64.0, 16.0);
bool oceanOn() { return g.planet.w > 0.5 && g.ocean1.w > 0.5; }
// mip for a pixel footprint pxM (m): 128 texels per patch
float oLod(int c, float pxM) { return max(log2(pxM * 128.0 / OSIZE[c]), 0.0); }
// No repeating patches (stochastic tiling, as hexTile in globe.rchit does for the ground): each
// cascade is laid out on hex cells ~1.5 patches across; every cell vertex places the patch at a
// random offset and turned up to +-25 degrees about the wind, and the three vertices around a
// point are blended (weights sharpened, variance-preserving: the fields are zero-mean, a plain
// mix would flatten the sea). Slopes and displacements are turned back into the patch frame.
// Wave groups: each cascade's amplitude also rises and falls over ~1-2 patches; whitecaps follow.
// The layout is set once per pixel (oWeights): it varies over hundreds of metres.
mat2 oRot[12];
vec2 oOff[12];
vec4 oW3[4];   // xyz vertex weights (normalised), w variance-preserving gain
vec4 oGrp = vec4(1.0);
void oWeights(vec2 q) {
    for (int c = 0; c < 4; ++c) {
        vec2 st = q / (OSIZE[c] * 1.5);
        vec2 sk = vec2(st.x, -0.57735027 * st.x + 1.15470054 * st.y);
        vec2 base = floor(sk);
        vec3 t = vec3(fract(sk), 0.0);
        t.z = 1.0 - t.x - t.y;
        float sg = step(0.0, -t.z), s2 = 2.0 * sg - 1.0;
        vec3 w = vec3(-t.z * s2, sg - t.y * s2, sg - t.x * s2);
        vec2 v[3] = vec2[3](base + vec2(sg, sg), base + vec2(sg, 1.0 - sg), base + vec2(1.0 - sg, sg));
        w = w * w * w;
        w /= w.x + w.y + w.z;
        oW3[c] = vec4(w, inversesqrt(dot(w, w)));
        for (int i = 0; i < 3; ++i) {
            uint r = hash2(uvec2(ivec2(v[i]) + 32768) ^ uvec2(uint(c) * 7919u));
            float ang = (float(r & 0xFFFFu) / 65535.0 - 0.5) * 0.87;
            oRot[c * 3 + i] = mat2(cos(ang), sin(ang), -sin(ang), cos(ang));
            oOff[c * 3 + i] = vec2(float((r >> 16) & 0xFFu), float(r >> 24)) / 256.0;
        }
        oGrp[c] = 0.6 + 0.8 * vnoise(q / (OSIZE[c] * 1.31) + float(c) * 11.7 + 3.1);
    }
}
vec4 oSample(int k, int c, vec2 q, float lod, bool isA) {
    vec2 uv = q / OSIZE[c];
    vec4 m = vec4(0.0);
    float f = 0.0;
    for (int i = 0; i < 3; ++i) {
        float w = oW3[c][i];
        if (w < 0.01) continue;
        mat2 R = oRot[c * 3 + i];
        vec4 v = textureLod(oceanTex[k], R * uv + oOff[c * 3 + i], lod);
        // vectors (A: displacement xz; B: slope xy) back from the turned patch
        if (isA) v.xz = transpose(R) * v.xz; else v.xy = transpose(R) * v.xy;
        m += v * w;
        f += (isA ? v.w : 0.0) * w;
    }
    m *= oW3[c].w * oGrp[c];
    if (isA) m.w = f * smoothstep(0.7, 1.3, oGrp[c]);
    return m;
}
vec4 oA(int c, vec2 q, float lod) { return oSample(2 * c, c, q, lod, true); }
vec4 oB(int c, vec2 q, float lod) { return oSample(2 * c + 1, c, q, lod, false); }
// The undisplaced point whose choppy displacement lands on q (two fixed-point steps).
vec2 oUndisplace(vec2 q, vec4 amp, vec4 lod) {
    vec2 x = q;
    for (int i = 0; i < 2; ++i) {
        vec2 d = oA(0, x, lod.x).xz * amp.x + oA(1, x, lod.y).xz * amp.y + oA(2, x, lod.z).xz * amp.z;
        x = q - d;
    }
    return x;
}
// Wave height above the mean level at q (cascades 0-2: the finest is surface detail only).
float oHeight(vec2 q, vec4 amp, vec4 lod) {
    vec2 x = oUndisplace(q, amp, lod);
    return oA(0, x, lod.x).y * amp.x + oA(1, x, lod.y).y * amp.y + oA(2, x, lod.z).y * amp.z;
}
// DLSS Ray Reconstruction G-buffer (written when g.lodParams.z > 0.5)
layout(set = 0, binding = 17, r32f) uniform writeonly image2D viewzImg;
layout(set = 0, binding = 18, rg16f) uniform writeonly image2D motionImg;
layout(set = 0, binding = 19, rgba16f) uniform writeonly image2D normalImg;
layout(set = 0, binding = 20, rgba8) uniform writeonly image2D diffImg;
layout(set = 0, binding = 21, rgba8) uniform writeonly image2D specImg;

layout(location = 0) rayPayloadEXT HitPayload pl;
layout(location = 1) rayPayloadEXT uint vis;

vec3 sunColor() { return vec3(1.0, 0.92, 0.80) * g.sunDir.w; }

// Globe mode (g.planet.w = 1): the camera frame is east / up / south at the camera, the planet
// centre at g.planet.xyz; sky, sunlight, sky light and aerial perspective come from the
// physically based atmosphere (atmosphere.glsl).
bool globe() { return g.planet.w > 0.5; }
// Longest primary / reflection ray: the forest scene ends within 100 km; on the globe the far
// side of the planet from orbit is ~10,000 km away.
float farRay() { return globe() ? 2.0e7 : 1.0e5; }
vec3 globeSkyFrom(vec3 ro, vec3 d);
vec3 globeSky(vec3 d) { return globeSkyFrom(-g.planet.xyz, d); }
// The sky seen from ro (relative to the planet centre) in direction d (reflections: from the
// reflecting point, not the camera; from orbit the two differ).
vec3 globeSkyFrom(vec3 ro, vec3 d) {
    vec3 T;
    vec3 c = atmosphere(ro, d, 1e30, g.sunDir.xyz, g.sunDir.w, T);
    vec2 hg = raySphere(ro, d, R_GROUND);
    if (hg.x > 0.0 && hg.y > 0.0) return c; // the planet hides what lies behind it
    // the sun's disc (the real sun, also when the moon is the light)
    if (dot(d, g.sunTrue.xyz) > 0.99996) c += 4.6 * 2000.0 * T;
    // the moon: a sphere lit by the sun (phase), albedo ~0.12, seen through the atmosphere
    float mr = g.moon.w;
    float cd = dot(d, g.moon.xyz);
    if (mr > 0.0 && cd > cos(mr)) {
        // point on the moon's sphere under this pixel (unit sphere, centre along g.moon)
        vec3 side = d - g.moon.xyz * cd;
        float r = clamp(length(side) / sin(mr), 0.0, 1.0);
        vec3 nrm = normalize(side / sin(mr) - g.moon.xyz * sqrt(1.0 - r * r));
        float lit = max(dot(nrm, g.sunTrue.xyz), 0.0);
        // physical brightness by day (a pale day-time moon); at night the eye sees the phase, not
        // a clipped disc: at most ~2x white after the exposure
        float L = min(4.6 * 0.12 / PI, 2.0 / max(g.sunTrue.w * g.params.z, 1e-6));
        c += L * lit * T;
    }
    return c;
}

float cloudFbm(vec2 p) {
    float s = 0.0, a = 0.5;
    for (int i = 0; i < 5; ++i) {
        s += a * vnoise(p);
        p = p * 2.07 + vec2(13.1, 7.7);
        a *= 0.5;
    }
    return s;
}

vec3 skyColor(vec3 d) {
    if (globe()) return globeSky(d);
    vec3 L = g.sunDir.xyz;
    float y = clamp(d.y, -1.0, 1.0);
    vec3 zenith = vec3(0.045, 0.14, 0.46);
    vec3 horizon = vec3(0.40, 0.56, 0.80);
    vec3 c = mix(horizon, zenith, pow(max(y, 0.0), 0.5));
    if (y < 0.0) c = horizon * mix(1.0, 0.85, clamp(-y * 4.0, 0.0, 1.0)); // beyond the terrain: haze
    float s = max(dot(d, L), 0.0);
    c += vec3(1.0, 0.85, 0.62) * (0.15 * pow(s, 6.0) + 0.45 * pow(s, 64.0));

    // Fair-weather cumulus painted on a flat layer, when the volumetric clouds are off
    // (forestClouds below; static so still frames can accumulate).
    if (y > 0.0 && !cloudsOn()) {
        vec2 uv = d.xz / (y + 0.06) * 0.55;
        float n = cloudFbm(uv * 1.3);
        float cover = smoothstep(0.52, 0.72, n) * smoothstep(0.0, 0.12, y);
        float shade = clamp((cloudFbm(uv * 1.3 + L.xz * 0.06) - n) * 4.0 + 0.6, 0.0, 1.0); // lit side towards the sun
        vec3 cloud = mix(vec3(0.55, 0.60, 0.68), vec3(1.25, 1.22, 1.15), shade);
        c = mix(c, cloud, cover * 0.95);
    }
    return c;
}

// Pixel position of world point x (or direction, w = 0) in a camera given as pos/right/up/fwd.
vec2 projectPx(vec4 x, vec4 pos, vec4 right, vec4 up, vec4 fwd, vec2 size) {
    vec3 v = x.w > 0.5 ? x.xyz - pos.xyz : x.xyz;
    float z = max(dot(v, fwd.xyz), 1e-4);
    vec2 ndc = vec2(dot(v, right.xyz) / (z * right.w), -dot(v, up.xyz) / (z * up.w));
    return (ndc * 0.5 + 0.5) * size;
}

// Pre-integrated specular albedo for F0 = 0.04 (Karis' analytic fit of the split-sum LUT).
float specAlbedo(float NoV, float rough) {
    const vec4 c0 = vec4(-1.0, -0.0275, -0.572, 0.022);
    const vec4 c1 = vec4(1.0, 0.0425, 1.04, -0.04);
    vec4 r = rough * c0 + c1;
    float a004 = min(r.x * r.x, exp2(-9.28 * NoV)) * r.x + r.y;
    vec2 AB = vec2(-1.04, 1.04) * a004 + r.zw;
    return 0.04 * AB.x + AB.y;
}

// Aerial perspective in-scatter colour: horizon sky plus forward scattering around the sun.
vec3 hazeColor(vec3 d) {
    float s = max(dot(d, g.sunDir.xyz), 0.0);
    return vec3(0.47, 0.58, 0.72) * 0.95 + vec3(1.0, 0.85, 0.62) * (0.10 * pow(s, 4.0) + 0.25 * pow(s, 24.0));
}

// The forest scenes' volumetric clouds (clouds.glsl) over `col`, along from + dir * [0, t]
// (`from` relative to the planet centre; t < 0: the ray went to the sky, and col is that sky).
// The scene's own haze lies in front of them: far clouds fade into the sky behind them.
vec3 forestClouds(vec3 col, vec3 from, vec3 dir, float t, int steps, float jitter) {
    float tmax = t;
    if (t < 0.0) {
        // (below the horizon, beyond the terrain's edge: to the ground, not round the planet)
        vec2 gs = raySphere(from, dir, R_GROUND - CLOUD_LIFT - 600.0);
        tmax = gs.x > 0.0 ? gs.x : 1e30;
    }
    float tFirst;
    vec4 c = cloudScatter(from, dir, tmax, steps, jitter, tFirst);
    if (tFirst < 0.0) return col;
    // (grey: the scene's haze reddens what is behind it, and a far cloud lit warm, dimmed red
    // and veiled blue comes out pink)
    vec3 Ta = vec3(exp(-14.0e-6 * g.extra.x * tFirst));
    vec3 behind = t < 0.0 ? col : hazeColor(dir);
    return col * c.a + c.rgb * Ta + behind * (1.0 - Ta) * (1.0 - c.a);
}

float traceShadow(vec3 o, vec3 d, float tmax, uint mask) {
    vis = 0u;
    traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                mask, 0, 0, 1, o, 0.0, d, tmax, 1);
    return float(vis);
}

void main() {
    atmoHaze = 1.0 + g.city.y;
    uvec2 px = gl_LaunchIDEXT.xy;
    uvec2 size = gl_LaunchSizeEXT.xy;
    uint accumN = g.iparams.x;
    uint dbg = g.iparams.y;
    uint rng = hash2(px) ^ pcg(g.iparams.z * 9781u + 17u);

    // Moving: one Halton sub-pixel offset per frame for TAA. Still: random per pixel for accumulation.
    vec2 jitter = accumN > 0u ? vec2(rnd(rng), rnd(rng)) : taaJitter(g.iparams.z);
    vec2 ndc = (vec2(px) + jitter) / vec2(size) * 2.0 - 1.0;
    vec3 dir = normalize(g.camFwd.xyz + g.camRight.xyz * (ndc.x * g.camRight.w) - g.camUp.xyz * (ndc.y * g.camUp.w));
    vec3 org = g.camPos.xyz;

    pl.t = -1.0;
    pl.sunVis = 1.0;
    pl.shadowMask = 0xFFu;
    pl.trans = vec3(0.0);
    pl.wdepth = 0.0;
    pl.wlevel = 0.0;
    pl.wfloor = 0.0;
#ifdef SER
    // Shader Execution Reordering (RTX 40/50): traverse, then regroup the threads by what they
    // hit (ground, textured leaves, impostors, sky) before running the closest-hit / miss shader,
    // so neighbouring threads shade the same material. Same result as traceRayEXT.
    hitObjectNV hitObj;
    hitObjectTraceRayNV(hitObj, tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, org, 0.02, dir, farRay(), 0);
    reorderThreadNV(hitObj);
    hitObjectExecuteShaderNV(hitObj, 0);
#else
    traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, org, 0.02, dir, farRay(), 0);
#endif

    if (craftOn() && dbg == 0u) {
        // The aircraft's shock waves and its exhaust bend the light that passes through them
        // (aircraft.glsl craftBend): whatever lies behind them is looked for again along the
        // bent ray. (From the camera: the bend is small and the aircraft near. The aircraft
        // itself is left as it is: its own outline does not swim, and a bent ray does not see
        // it either (its instances have a mask bit of their own), or the rays that pass just
        // outside the outline would draw a second and a third wing tip beside the first.)
        vec3 bend;
        float tb = craftBend(org, dir, bend);
        bool own = pl.t >= 0.0 && (pl.flags & FLAG_AIRCRAFT) != 0u;
        if (tb > 0.0 && !own && (pl.t < 0.0 || pl.t > tb)) {
            dir = normalize(dir + bend);
            pl.t = -1.0;
            pl.sunVis = 1.0;
            pl.shadowMask = 0xFFu;
            pl.trans = vec3(0.0);
            pl.wdepth = 0.0;
            pl.wlevel = 0.0;
            pl.wfloor = 0.0;
            traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFB, 0, 0, 0, org, 0.02, dir, farRay(), 0);
        }
    }
    vec3 L = g.sunDir.xyz;
    vec3 col;
    bool craftHit = pl.t >= 0.0 && (pl.flags & FLAG_AIRCRAFT) != 0u; // the aircraft (--test-flight)
    // G-buffer values for DLSS Ray Reconstruction (sky defaults)
    vec3 gbN = -dir, gbAlb = vec3(0.0);
    float gbRough = 1.0, gbSpec = 0.0;
    if (pl.t < 0.0) {
        col = skyColor(dir);
        if (dot(dir, L) > 0.99995) col += vec3(60.0, 52.0, 40.0);
        if (dbg != 0u) col = vec3(0.35, 0.45, 0.6);
    } else {
        vec3 p = org + dir * pl.t;
        vec3 n = pl.n, ng = pl.ng;
        bool imp = (pl.flags & FLAG_IMPOSTOR) != 0u;
        if (dot(ng, dir) > 0.0) ng = -ng;
        if (imp) {
            if (dot(n, dir) > 0.0) n = -n;
        } else {
            // Shading normal on the geometric normal's side. A normal-mapped / interpolated normal
            // can tilt away from a grazing view (far slopes, ridge lines): bend it back towards the
            // viewer instead of flipping it underground (which made ambient and AO go black).
            if (dot(n, ng) < 0.0) n = -n;
            float nv = dot(n, -dir);
            if (nv < 0.03) n = normalize(n - dir * (0.03 - nv));
        }
        uint mat = pl.flags & 0xFFu;
        bool leaf = mat == MAT_LEAF;
        vec3 alb = pl.albedo;
        float ao = pl.ao;
        // Impostor normals arrive shortened to |mean n| (blade / leaf normal spread): Lambert on the
        // shortened normal is the texel's true mean diffuse. Everything else uses the direction.
        float nLen = max(length(n), 1e-4);
        vec3 nDir = n / nLen;
        float ndl = dot(n, L);
        float ndlDir = dot(nDir, L);

        // Offset the shadow origin to the side of the surface the light is on (back-lit leaves must
        // not hit themselves). Impostor hits exclude their own tree from the shadow ray via the
        // instance mask; their self-shadowing comes from the baked directional visibility.
        float side = dot(ng, L) >= 0.0 ? 1.0 : -1.0;
        vec3 so = imp ? p + L * (0.05 + pl.t * 2e-4) : p + ng * side * (0.003 + pl.t * 1.5e-4);
        uint profSkip = uint(g.params.x); // profiling only (SI_PROF_SKIP): 1 = no sun shadow rays, 2 = no AO rays
        float sh = (ndl > 0.0 || leaf) ? ((profSkip & 1u) != 0u ? 1.0 : traceShadow(so, L, 1.0e4, pl.shadowMask)) * pl.sunVis : 0.0;

        vec3 E = sunColor();
        vec3 gq = p - g.planet.xyz; // globe: position relative to the planet centre
        if (globe()) E = vec3(g.sunDir.w) * extinction(lightDepth(gq, L)) * cloudShadow(gq, L);
        // (the forest scenes: the clouds' shadows drift over the land)
        float cloudSun = 1.0;
        if (!globe() && cloudsOn() && dbg == 0u) {
            cloudSun = cloudShadow(gq, L);
            E *= cloudSun;
        }
        vec3 direct = alb / PI * E * max(ndl, 0.0) * sh;
        // Leaf transmission: the foliage texture's translucency map times Unreal's "Translucency Tint"
        // (veins and thick spots transmit less), so back-lit leaves glow with visible veins.
        // A mesh leaf transmits by its own orientation, so back-light spreads over many leaves at
        // moderate strength. An impostor normal is the crown hull's: max(-ndl) would put the whole
        // crown's transmission on the side facing away from the sun at full strength (hot spots
        // that the tonemapper bleaches to yellow-white). Averaged over randomly oriented leaves
        // the response is a broad lobe with the same total energy and half the peak.
        float transW = imp ? 0.25 * (1.0 - ndlDir) : max(-ndl, 0.0);
        vec3 transTerm = leaf ? pl.trans * 2.0 / PI * E * transW * sh : vec3(0.0);
        direct += transTerm; // per-species transmission colour
        vec3 specTerm = vec3(0.0);
        // Waxy leaf tops: GGX specular sun highlight (F0 0.04).
        if ((pl.flags & FLAG_GLOSSY) != 0u && imp) {
            // An impostor texel stands for a crown of glossy leaves in all orientations: some leaf
            // always faces the half vector, so the sun's reflection is a Fresnel sheen of the
            // view/sun geometry, not of the averaged hull normal (a lobe on that normal either
            // vanishes or lights every texel at once: frosty trees). Calibrated against the real
            // leaves with debug view 9: front-lit within 3-10%, back-lit within ~0.7-1.2x per
            // species (leaf orientation differs: alder leaves face up, beech droop).
            const float IMP_SHEEN = 1.05;
            vec3 V = -dir;
            float VdH = max(dot(V, normalize(L + V)), 0.0);
            float F = 0.04 + 0.96 * pow(1.0 - VdH, 5.0);
            specTerm = E * (IMP_SHEEN * F / (8.0 * PI)) * sh;
            direct += specTerm;
        } else if ((pl.flags & FLAG_GLOSSY) != 0u && ndl > 0.0) {
            float rough = 0.35;
            vec3 V = -dir;
            vec3 H = normalize(L + V);
            float NdH = max(dot(n, H), 0.0), NdV = max(dot(n, V), 1e-3);
            float a = rough * rough, a2 = a * a;
            float dd = NdH * NdH * (a2 - 1.0) + 1.0;
            float D = a2 / (PI * dd * dd);
            float F = 0.04 + 0.96 * pow(1.0 - max(dot(H, V), 0.0), 5.0);
            float k = a * 0.5;
            float G = ndl / (ndl * (1.0 - k) + k) * NdV / (NdV * (1.0 - k) + k);
            specTerm = E * (D * F * G / (4.0 * NdV)) * sh; // (... / (4 NdV NdL)) * NdL
            direct += specTerm;
        }

        // Ambient occlusion. Ground hits use long rays (30 m): the canopy overhead blocks most of
        // the sky, so the forest floor under the crowns goes properly dark, not just the 4 m around
        // trunks. Range scaled with distance keeps far terrain cheap.
        // (a lawn blade is an impostor hit, but it is the ground: the canopy overhead shades it)
        bool lawn = (pl.flags & FLAG_LAWN) != 0u;
        bool terrain = mat == MAT_TERRAIN || lawn;
        float aoRange = terrain ? 30.0 : g.params.w;
        // In a city (Globals.city.x) the buildings and the ground get one traced bounce of light
        // instead (below): no AO rays there.
        bool giOn = globe() && g.city.x > 0.5 && dbg == 0u && (profSkip & 2u) == 0u && pl.t < 8000.0
                    && ((pl.flags & FLAG_BUILDING) != 0u || (mat == MAT_TERRAIN && (pl.flags & FLAG_WATER) == 0u));
        if (!giOn && (!imp || lawn) && g.iparams.w > 0u && (profSkip & 2u) == 0u && pl.t < (terrain ? 600.0 : 150.0)) {
            float occ = 0.0;
            for (uint i = 0u; i < g.iparams.w; ++i) {
                vec3 d2 = cosineSample(n, rng);
                occ += 1.0 - traceShadow(p + ng * 0.01, d2, aoRange, 0xFFu);
            }
            ao *= 1.0 - occ / float(g.iparams.w);
        }
        bool glossy = (pl.flags & FLAG_GLOSSY) != 0u;
        // The hit is the bed under a water surface the ray crossed first (camera above it)?
        float wd = pl.wdepth;
        float tSurf = (wd > 0.0 && dir.y < -1e-4) ? (p.y + wd - org.y) / dir.y : -1.0;
        // globe terrain: the hit is the water surface itself, the bed lies wd below it (globe.rchit:
        // depth from the shoreline field and the sea floor)
        float under = -1.0;
        bool sea = (pl.flags & FLAG_SEA) != 0u;
        bool globeWater = globe() && (pl.flags & FLAG_WATER) != 0u;
        vec3 wq = pl.trans, wtan = pl.wtan; // globe water: Earth-fixed coordinates, shore distance
        float wfloor = pl.wfloor;
        bool seaFFT = globeWater && sea && oceanOn() && dbg == 0u;
        float waveH = 0.0;  // height of the wave surface above the mean level at the hit (m)
        vec4 oAmp = vec4(1.0);
        if (globeWater) {
            // the hit is the ground under the flat water surface, wlevel below it
            float cosV = max(dot(-dir, normalize(gq)), 0.02);
            tSurf = max(pl.t - pl.wlevel / cosV, pl.t * 0.5);
            wd = max(wd, 0.02);
            under = wd / max(cosV, 0.05);
            if (seaFFT) {
                // the waves feel the bottom near the shore: long ones die out first
                float dep = max(wfloor, wd);
                // in a city the bay and the canals are sheltered and shallow: the waves feel the
                // real floor (ETOPO), not the shelf the shore field draws, so the swell dies out
                // and only the wind's ripples remain; the open sea outside keeps its waves
                if (g.city.x > 0.5) dep = min(dep, max(wfloor, 0.5) * 1.4 + 0.5);
                oAmp = vec4(smoothstep(0.0, 25.0, dep), smoothstep(0.0, 8.0, dep), smoothstep(0.0, 2.0, dep), smoothstep(0.0, 0.4, dep));
                // (a city's bay is sheltered: no swell, the wind's chop halved; the long cascades'
                // tiling showed as zig-zag bands across it)
                if (g.city.x > 0.5) oAmp *= vec4(0.0, 0.25, 0.6, 1.0);
                // Real wave geometry: march the ray through the slab the waves fill (+-A around
                // the mean level) against the height field, first crossing refined by bisection.
                // Crests hide the troughs behind them at grazing angles; within 1.5 km.
                float A = g.ocean0.z * max(max(oAmp.x, oAmp.y), oAmp.z);
                if (tSurf < 1500.0 && A > 0.05) {
                    float vS = length(wtan) > 1.5 ? -1.0 : 1.0;
                    vec3 tn = normalize(wtan), vn = cross(normalize(gq), tn) * vS;
                    vec2 dq = vec2(dot(dir, tn), dot(dir, vn));
                    float tA = max(tSurf - A / cosV, 0.0), tB = min(tSurf + A / cosV, pl.t);
                    float pxM = tSurf * 2.0 * g.camUp.w / float(size.y) / max(cosV, 0.15);
                    vec4 lod = vec4(oLod(0, pxM), oLod(1, pxM), oLod(2, pxM), 0.0);
                    vec2 qA = wq.xy + (tA - pl.t) * dq; // (wq is at the bed point, t = pl.t)
                    oWeights(wq.xy + (tSurf - pl.t) * dq);
                    // (the 64 m cascade's centimetre waves only shape the silhouette up close)
                    vec4 mAmp = vec4(oAmp.xy, oAmp.z * smoothstep(150.0, 60.0, tSurf), 0.0);
                    const int STEPS = 20;
                    float dt = (tB - tA) / float(STEPS), j = rnd(rng);
                    float lo = tA, hi = -1.0;
                    for (int i = 1; i <= STEPS; ++i) {
                        float t = tA + dt * min(float(i) - 1.0 + j + 0.001, float(STEPS));
                        if ((tSurf - t) * cosV <= oHeight(qA + (t - tA) * dq, mAmp, lod)) {
                            hi = t;
                            break;
                        }
                        lo = t;
                    }
                    if (hi > 0.0) {
                        for (int i = 0; i < 5; ++i) {
                            float t = 0.5 * (lo + hi);
                            if ((tSurf - t) * cosV <= oHeight(qA + (t - tA) * dq, mAmp, lod)) hi = t; else lo = t;
                        }
                        waveH = (tSurf - hi) * cosV;
                        tSurf = hi;
                    }
                }
            }
        } else if ((pl.flags & FLAG_WATER) != 0u && wd <= 0.0) {
            tSurf = pl.t;
            wd = 6.0; // open water: no shallows, no foam
        }
        bool water = tSurf > 0.0 && tSurf <= pl.t;
        gbN = nDir;
        gbAlb = alb;
        gbRough = water ? 0.05 : glossy ? (imp ? 0.6 : 0.35) : 1.0;
        gbSpec = (glossy || water) ? specAlbedo(max(dot(n, -dir), 0.0), gbRough) : 0.0;
        // Sky fill is kept well below the sun so shaded crowns go properly dark.
        vec3 skyUp = vec3(0.13, 0.20, 0.36), ground = vec3(0.05, 0.06, 0.035);
        // (in a cloud's shadow the light from above is the cloud's, the sun's diffused through
        // it: grey, and more than the blue sky's)
        skyUp = mix(vec3(0.30, 0.31, 0.33), skyUp, cloudSun);
        vec3 amb = mix(ground, skyUp, n.y * 0.5 + 0.5);
        if (globe()) {
            // sky light: the zenith radiance over the hemisphere (as globe.rgen did)
            vec3 up = normalize(gq), Tz;
            vec3 skyZ = atmosphere(gq, up, 1e30, L, g.sunDir.w, Tz);
            // under the clouds less sky light reaches the ground (an overcast sky is dimmer)
            if (cloudsOn()) skyZ *= 1.0 - 0.45 * cloudCover(cloudEarth(gq));
            skyUp = skyZ * PI;
            ground = skyUp * 0.25;
            amb = skyZ * PI * (0.6 + 0.4 * dot(nDir, up));
        }
        // the light from everything around (irradiance / PI): the sky model and AO, or in a city
        // one traced bounce: a cosine-distributed ray, lit at what it hits by the sun (its own
        // shadow ray) and the sky, or the sky's radiance where it escapes. Walls in shade take up
        // the sunlit street and the towers across it; DLSS Ray Reconstruction averages the one
        // sample per pixel.
        vec3 indirect = amb * ao;
        if (giOn) {
            HitPayload keep = pl;
            vec3 upW = normalize(gq);
            vec3 d2 = cosineSample(nDir, rng);
            if (dot(d2, ng) < 0.0) d2 = reflect(d2, ng);
            vec3 o2 = p + ng * (0.02 + keep.t * 2e-4);
            pl.t = -1.0;
            pl.sunVis = 1.0;
            pl.shadowMask = 0xFFu;
            pl.trans = vec3(0.0);
            pl.wdepth = 0.0;
            pl.wlevel = 0.0;
            pl.wfloor = 0.0;
            traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, o2, 0.02, d2, 4000.0, 0);
            vec3 Lin;
            if (pl.t < 0.0) {
                Lin = dot(d2, upW) > 0.0 ? globeSkyFrom(gq, d2) : skyUp * 0.25 / PI;
                if (cloudsOn()) Lin *= 1.0 - 0.45 * cloudCover(cloudEarth(gq));
            } else {
                vec3 hp = o2 + d2 * pl.t;
                vec3 hn = normalize(dot(pl.n, d2) > 0.0 ? -pl.n : pl.n);
                vec3 hg = dot(pl.ng, d2) > 0.0 ? -pl.ng : pl.ng;
                float hndl = dot(hn, L);
                float hsh = hndl > 0.0 ? traceShadow(hp + hg * (0.02 + pl.t * 2e-4), L, 1.0e4, 0xFFu) * pl.sunVis : 0.0;
                vec3 ha = pl.albedo;
                if ((pl.flags & FLAG_BUILDING) != 0u) ha *= mix(1.0, 0.2, clamp(pl.trans.z, 0.0, 1.0));
                if ((pl.flags & FLAG_WATER) != 0u) ha = vec3(0.02, 0.03, 0.035);
                Lin = ha / PI * E * max(hndl, 0.0) * hsh + ha * skyUp * (0.6 + 0.4 * max(dot(hn, upW), 0.0)) / PI * pl.ao;
            }
            pl = keep;
            // (on the scale of the sky model above: amb is PI x the zenith radiance)
            indirect = Lin * PI * ao;
        }
        col = direct + alb * indirect;
        // a city at dusk: the street lamps' pools of light on the ground (globe.rchit cityLamp)
        if (globe() && mat == MAT_TERRAIN && !globeWater && g.city.x > 0.5) {
            float duskG = smoothstep(0.15, -0.06, dot(L, normalize(gq)));
            col += alb / PI * pl.wtan * (g.sunDir.w * 0.06 * duskG);
        }
        if (craftHit && dbg == 0u) {
            // The aircraft's paint and metal (aircraft.rchit: roughness, metal, emission): a GGX
            // sun highlight, and the sky above and the land below mirrored by how smooth the
            // surface is: faintly in the matt paint, clearly in the canopy's gold film.
            float rough = clamp(pl.trans.x, 0.04, 1.0), metal = pl.trans.y;
            vec3 V = -dir;
            vec3 F0 = mix(vec3(0.04), alb, metal);
            vec3 diffA = alb * (1.0 - metal);
            float NdV = max(dot(nDir, V), 1e-3);
            vec3 spec = vec3(0.0);
            if (ndl > 0.0) {
                vec3 H = normalize(L + V);
                float NdH = max(dot(nDir, H), 0.0);
                float a = rough * rough, a2 = a * a;
                float dd = NdH * NdH * (a2 - 1.0) + 1.0;
                float D = min(a2 / (PI * dd * dd), 300.0);
                float k = a * 0.5;
                float G = ndl / (ndl * (1.0 - k) + k) * NdV / (NdV * (1.0 - k) + k);
                vec3 F = F0 + (1.0 - F0) * pow(1.0 - max(dot(H, V), 0.0), 5.0);
                spec = E * F * (D * G / (4.0 * NdV)) * sh;
            }
            vec3 upW = globe() ? normalize(gq) : vec3(0.0, 1.0, 0.0);
            vec3 R = reflect(dir, nDir);
            float ru = dot(R, upW);
            vec3 skyR, landR;
            if (globe()) {
                vec3 Tt;
                skyR = atmosphere(gq, normalize(R + upW * max(0.03 - ru, 0.0)), 1e30, L, g.sunDir.w, Tt);
                landR = (E * max(dot(L, upW), 0.0) + skyUp) * (0.14 / PI);
            } else {
                skyR = skyColor(normalize(R + upW * max(0.03 - ru, 0.0)));
                landR = ground * 2.0;
            }
            vec3 env = mix(landR, skyR, smoothstep(-0.08, 0.08, ru));
            env = mix(env, amb, rough * rough); // (a rough surface mirrors a blur of all of it)
            vec3 envW = (F0 + (max(vec3(1.0 - rough), F0) - F0) * pow(1.0 - NdV, 5.0)) * (1.0 - 0.5 * rough);
            col = diffA / PI * E * max(ndl, 0.0) * sh + diffA * amb * ao + spec + env * envW * (0.5 + 0.5 * ao) + pl.wtan * 1.5;
            gbAlb = diffA;
            gbRough = rough;
            gbSpec = max(envW.r, max(envW.g, envW.b));
        }

        if ((pl.flags & FLAG_BUILDING) != 0u && dbg == 0u) {
            // A building (tri.rchit buildingHit, impostor.rchit): walls are matte; glass has a dark
            // interior behind it and reflects by Fresnel, its coating tinting the reflection (the
            // albedo is that tint). The reflection is traced (other towers, the bay, the sky),
            // the sun's highlight is GGX.
            float gls = clamp(pl.trans.z, 0.0, 1.0);
            // its own light (building.rchit / impostor.rchit: windows, lamps, car lights), in
            // the sun's units, coming up as the sun sets: a lit room is about 1/1500 of the
            // sunlit facade's radiance (brighter than that: a city at dusk reads by its lights)
            vec3 emitB = pl.wtan;
            float dusk = globe() ? smoothstep(0.15, -0.06, dot(L, normalize(gq))) : 0.0;
            // car paint (building.rchit: trans.x): its colour under a smooth clearcoat
            bool coat = pl.trans.x > 0.5;
            bool plainGlass = pl.trans.y > 0.5;
            float rough = coat ? 0.09 : mix(0.85, 0.035, gls);
            vec3 V = -dir;
            float NdV = max(dot(nDir, V), 1e-3);
            vec3 diffA = alb * mix(1.0, 0.11, gls);
            vec3 F0 = coat ? vec3(0.05) : plainGlass ? vec3(0.04) : mix(vec3(0.04), vec3(0.15) + alb * 0.32, gls); // coated curtain-wall glass: 0.25-0.35 at normal incidence
            vec3 spec = vec3(0.0);
            if (ndl > 0.0) {
                vec3 H = normalize(L + V);
                float NdH = max(dot(nDir, H), 0.0);
                float a = rough * rough, a2 = a * a;
                float dd = NdH * NdH * (a2 - 1.0) + 1.0;
                float D = min(a2 / (PI * dd * dd), 400.0);
                float k = a * 0.5;
                float G = ndl / (ndl * (1.0 - k) + k) * NdV / (NdV * (1.0 - k) + k);
                vec3 F = F0 + (1.0 - F0) * pow(1.0 - max(dot(H, V), 0.0), 5.0);
                spec = E * F * (D * G / (4.0 * NdV)) * sh;
            }
            vec3 Fe = F0 + (max(vec3(1.0 - rough), F0) - F0) * pow(1.0 - NdV, 5.0);
            vec3 env = amb;
            if (gls > 0.2 || coat) {
                vec3 upW = globe() ? normalize(gq) : vec3(0.0, 1.0, 0.0);
                vec3 R = reflect(dir, nDir);
                vec3 org2 = p + ng * (0.05 + pl.t * 2e-4);
                float tB = pl.t;
                pl.t = -1.0;
                pl.sunVis = 1.0;
                pl.shadowMask = 0xFFu;
                pl.trans = vec3(0.0);
                traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, org2, 0.02, R, farRay(), 0);
                if (pl.t < 0.0) {
                    env = globe() ? globeSkyFrom(gq, R) : skyColor(R);
                } else {
                    vec3 rp = org2 + R * pl.t;
                    vec3 rn = dot(pl.n, R) > 0.0 ? -pl.n : pl.n;
                    vec3 rg = dot(pl.ng, R) > 0.0 ? -pl.ng : pl.ng;
                    float rndl = dot(normalize(rn), L);
                    float rsh = rndl > 0.0 ? traceShadow(rp + rg * (0.02 + pl.t * 2e-4), L, 1.0e4, 0xFFu) * pl.sunVis : 0.0;
                    vec3 rA = (pl.flags & FLAG_BUILDING) != 0u ? pl.albedo * mix(1.0, 0.25, clamp(pl.trans.z, 0.0, 1.0)) : pl.albedo;
                    env = rA / PI * E * max(rndl, 0.0) * rsh + rA * mix(ground, skyUp, dot(normalize(rn), upW) * 0.5 + 0.5) * pl.ao;
                    if ((pl.flags & FLAG_WATER) != 0u) env = env * 0.3 + (globe() ? globeSkyFrom(gq, reflect(R, upW)) : skyColor(reflect(R, upW))) * 0.1;
                    if (globe()) {
                        vec3 Tr;
                        vec3 S = atmosphere(gq, R, pl.t, L, g.sunDir.w, Tr);
                        env = env * Tr + S;
                    }
                }
                pl.t = tB;
            }
            // (a car's tinted windows over a dark cabin: the reflection held down, so the glass
            // reads dark as on a real car seen from above)
            if (plainGlass) { Fe *= 0.5; diffA *= 0.3; }
            col = diffA / PI * E * max(ndl, 0.0) * sh + diffA * indirect + spec + env * Fe;
            col += emitB * (g.sunDir.w * 4.5e-3 * dusk);
            gbAlb = diffA;
            gbRough = rough;
            gbSpec = max(Fe.r, max(Fe.g, Fe.b));
        }

        if (water && dbg == 0u) {
            // Water surface over the bed (Unreal-style river shading): refraction of the lit bed
            // with depth absorption (Beer-Lambert) and in-scattering, flowing ripples, foam where
            // it is shallow, a ray-traced reflection by Fresnel, and the sun glint.
            vec3 ps = org + dir * tSurf;
            if (under < 0.0) under = pl.t - tSurf;     // view path through the water
            float sunPath = wd / max(L.y, 0.08);       // sunlight down to the bed
            // clear, slightly green lake / river water; the sea is bluer and scatters more blue
            // the sea: clear deep blue over the open ocean (pure water absorbs red, barely blue),
            // greener and murkier over the shelf (plankton, dissolved matter); by floor depth
            float open = sea ? smoothstep(25.0, 200.0, wfloor) : 0.0;
            vec3 SIGMA = sea ? mix(vec3(0.45, 0.075, 0.075), vec3(0.40, 0.055, 0.022), open) : vec3(0.42, 0.10, 0.075); // 1/m
            vec3 Tv = exp(-SIGMA * under);
            vec3 Ts = exp(-SIGMA * sunPath);
            // light scattered back out of deep water (globe: dark blue-green lakes, deep blue sea;
            // the bed shows only where it is shallow)
            vec3 body = !globe() ? vec3(0.012, 0.035, 0.032) : sea ? mix(vec3(0.0018, 0.0075, 0.012), vec3(0.0007, 0.0032, 0.0135), open) : vec3(0.003, 0.010, 0.010);
            vec3 inscat = body * (E * max(L.y, 0.0) * 0.5 + skyUp * 2.0);
            vec3 refr = col * Ts * Tv + inscat * (1.0 - Tv);
            // flowing ripples: two octaves drifting at different speeds and directions, fixed to
            // the ground (globe: the Earth-fixed water coordinates, not the camera frame)
            float tm = g.extra.w;
            // globe: the coordinates at the surface point (the hit is the ground under it)
            float vSign = length(wtan) > 1.5 ? -1.0 : 1.0;
            wtan = globeWater ? normalize(wtan) : vec3(1.0, 0.0, 0.0);
            vec3 wvd = cross(normalize(gq), wtan) * vSign;
            vec2 q = globeWater ? wq.xy + vec2(dot(ps - p, wtan), dot(ps - p, wvd)) : ps.xz;
            float e = 0.08;
            #define RIPPLE(Q) (0.022 * vnoise((Q) * 1.1 + vec2(0.55, 0.2) * tm) + 0.009 * vnoise((Q) * 3.3 - vec2(0.3, 0.75) * tm) + 0.004 * vnoise((Q) * 8.0 + vec2(0.9, 0.4) * tm))
            vec2 gr = vec2(0.0);
            float lostVar = 0.0; // slope variance of the ripples smaller than a pixel
            float waveFoam = 0.0;
            if (seaFFT) {
                // The sea from the FFT cascades at the (undisplaced) point under q: slopes of the
                // displaced surface (dh/dx / (1 + dDx/dx)), each cascade at the mip of the pixel.
                // What the mips average away and what lies below the finest cascade (Cox-Munk
                // total minus the resolved) is the roughness.
                float pxM = tSurf * 2.0 * g.camUp.w / float(size.y) / max(dot(-dir, normalize(gq)), 0.15);
                vec4 lod = vec4(oLod(0, pxM), oLod(1, pxM), oLod(2, pxM), oLod(3, pxM));
                oWeights(q);
                vec2 x = oUndisplace(q, oAmp, lod);
                vec2 s = vec2(0.0), jd = vec2(0.0);
                for (int c = 0; c < 4; ++c) {
                    vec4 b = oB(c, x, lod[c]) * oAmp[c];
                    s += b.xy;
                    jd += b.zw;
                    lostVar += g.ocean2[c] * oAmp[c] * oAmp[c] * (1.0 - exp2(-2.0 * lod[c]));
                }
                gr = s / max(vec2(1.0) + jd, vec2(0.25));
                lostVar += g.ocean0.y;
                // whitecaps where the crests fold (ocean.rs: the coverage for the wind)
                waveFoam = max(oA(1, x, lod.y).w * oAmp.y, oA(2, x, lod.z).w * oAmp.z);
            } else if (globeWater) {
                // wind waves: directional swells from 12 cm to 7 m spread around the wind, slope
                // ~0.04 each, gusts (slow patches) varying their strength; waves smaller than a
                // pixel are left out (no shimmer)
                float pxM = tSurf * 2.0 * g.camUp.w / float(size.y) / max(dot(-dir, normalize(gq)), 0.15);
                float gust = 0.35 + 0.9 * smoothstep(0.2, 0.8, vnoise(q * 0.025 + vec2(0.11, 0.07) * tm));
                // wind ripples: 8 octaves of value noise from 5 m to 8 cm, each turned a little off
                // the wind, stretched along its crests and drifting downwind at its wave speed;
                // noise, unlike a sum of sines, never lines up into spots or a grid. Octaves smaller
                // than a pixel are left out (no shimmer).
                gr = vec2(0.0);
                const float WIND = 0.7;
                // (10 octaves down to ~3 cm capillary ripples, crests 1.4x their spacing: choppy
                // water, not brushed streaks)
                for (int i = 0; i < 10; ++i) {
                    float fi = float(i);
                    float lam = 5.0 * pow(0.6, fi);
                    float ang = WIND + sin(fi * 2.399) * (0.45 + 0.05 * fi);
                    vec2 d = vec2(cos(ang), sin(ang)), c = vec2(-d.y, d.x);
                    float speed = sqrt(9.81 * lam / 6.2831853);
                    vec2 sp = vec2((dot(q, d) - speed * tm) / lam, dot(q, c) / (lam * 1.4)) + fi * 17.3;
                    vec3 nd = vnoiseD(sp);
                    float keep = 1.0 - smoothstep(lam * 0.15, lam * 0.5, pxM);
                    float slope = 0.09 * keep;
                    lostVar += 0.18 * 0.0081 * (1.0 - keep * keep);
                    // back from the stretched frame: d/dq = d * dx / lam + c * dy / (1.4 lam)
                    gr += (d * nd.y + c * nd.z / 1.4) * slope;
                }
                gr *= gust;
                lostVar *= 0.8; // the mean gust strength (gust patches would turn the glitter into blobs)
                if (sea) {
                    // (the sea before its first FFT frame: a stronger chop than a lake)
                    gr *= 1.8;
                    lostVar *= 3.2;
                }
            } else {
                float h0 = RIPPLE(q), hx = RIPPLE(q + vec2(e, 0.0)), hz = RIPPLE(q + vec2(0.0, e));
                gr = vec2(hx - h0, hz - h0) / e;
            }
            float foam;
            if (globeWater) {
                vec3 wup = normalize(gq);
                n = normalize(wup - wtan * gr.x - wvd * gr.y);
                // lapping foam: a thin, broken line that runs up and back at the waterline
                float sdW = wq.z;
                float swash = 0.5 + 0.35 * sin(tm * 0.9 + vnoise(q * 0.12) * 6.2831853);
                float band = smoothstep(-swash - 0.8, -swash * 0.4, sdW) * (1.0 - smoothstep(-0.1, 0.15, sdW));
                float brk = smoothstep(0.42, 0.78, vnoise(q * 1.6 + vec2(0.3, 0.5) * tm) * 0.6 + vnoise(q * 5.5 - vec2(0.2, 0.4) * tm) * 0.4);
                foam = band * brk * (sea ? 0.9 : 0.35) * smoothstep(300.0, 60.0, tSurf) * ((pl.flags & FLAG_SEAWALL) != 0u ? 0.0 : 1.0);
                // whitecaps (FFT sea): a breaking crest is a lace of bubbles and streaks, not a
                // solid patch; finer near the camera, an even mix further out (mips)
                // fresh foam on the breaking crest is dense and bright; older foam trails behind
                // it as thin streaks drawn out along the wind
                vec2 wd2 = g.ocean1.xy;
                vec2 qs = vec2(dot(q, wd2), dot(q, vec2(-wd2.y, wd2.x)));
                float lace = smoothstep(0.35, 0.8, vnoise(qs * vec2(0.8, 3.0) + tm * 0.2) * 0.6 + vnoise(qs * vec2(2.6, 8.0) - tm * 0.3) * 0.4);
                lace = mix(lace, 0.45, smoothstep(40.0, 300.0, tSurf));
                float fresh = smoothstep(0.7, 1.0, waveFoam);
                foam = max(foam, waveFoam * mix(lace, 1.0, 0.7 * fresh) * 0.85);
            } else {
                n = normalize(vec3(-gr.x, 1.0, -gr.y));
                // foam and white water where it is shallow at the shore
                foam = smoothstep(0.14, 0.02, wd) * smoothstep(0.35, 0.75, vnoise(q * 2.2 + vec2(0.4, 0.3) * tm) * 0.6 + vnoise(q * 7.0) * 0.4);
            }
            nDir = n;
            p = ps;
            pl.t = tSurf;
            col = refr;
            if (seaFFT) {
                // Light through the thin wave crests (Atlas GDC 2019 water BSDF, simplified): the
                // crests glow green-blue when the sun is behind them, a little on the faces too
                float hn = clamp(waveH / max(g.ocean0.z, 0.2), 0.0, 1.0);
                float back = pow(max(dot(L, dir), 0.0), 4.0) * pow(0.5 - 0.5 * dot(L, n), 3.0);
                float face = pow(max(dot(-dir, n), 0.0), 2.0);
                vec3 sssCol = mix(vec3(0.0, 0.07, 0.055), vec3(0.0, 0.04, 0.065), open);
                col += sssCol * E * sh * hn * (3.0 * back + 0.12 * face);
            }
            float tHit = pl.t;
            // the ripples smaller than a pixel still tilt the surface: one random facet per pixel
            // and frame from their slope spread (the denoiser averages them), so far water blurs
            // and stretches its reflections instead of turning into a mirror
            vec3 nR = n;
            if (globeWater && lostVar > 0.0) {
                float u1 = max(rnd(rng), 1e-6), u2 = rnd(rng);
                vec2 gz = sqrt(-2.0 * log(u1)) * vec2(cos(6.2831853 * u2), sin(6.2831853 * u2)) * sqrt(lostVar);
                nR = normalize(n - wtan * gz.x - wvd * gz.y);
            }
            vec3 R = reflect(dir, nR);
            if (globeWater) {
                vec3 wup = normalize(gq);
                float ru = dot(R, wup);
                if (ru < 0.01) R = normalize(R + wup * (0.01 - ru));
            } else {
                R = normalize(vec3(R.x, max(R.y, 0.01), R.z));
            }
            float cosT = max(dot(-dir, n), 0.0);
            float F = 0.02 + 0.98 * pow(1.0 - cosT, 5.0);
            pl.t = -1.0;
            pl.sunVis = 1.0;
            pl.shadowMask = 0xFFu;
            pl.trans = vec3(0.0);
            traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, p + (globeWater ? normalize(gq) : vec3(0.0, 1.0, 0.0)) * 0.05, 0.02, R, farRay(), 0);
            vec3 refl;
            if (pl.t < 0.0) {
                refl = globeWater ? globeSkyFrom(p - g.planet.xyz, R) : skyColor(R);
            } else {
                vec3 rp = p + R * pl.t;
                vec3 rn = dot(pl.n, R) > 0.0 ? -pl.n : pl.n;
                vec3 rng2 = dot(pl.ng, R) > 0.0 ? -pl.ng : pl.ng;
                float rndl = dot(rn, L);
                float rsh = (rndl > 0.0) ? traceShadow(rp + rng2 * (0.01 + pl.t * 2e-4), L, 1.0e4, 0xFFu) * pl.sunVis : 0.0;
                vec3 ramb = mix(ground, skyUp, rn.y * 0.5 + 0.5);
                refl = pl.albedo / PI * E * max(rndl, 0.0) * rsh + pl.albedo * ramb * pl.ao;
                if (globe()) {
                    vec3 Tr;
                    vec3 S = atmosphere(p - g.planet.xyz, R, pl.t, L, g.sunDir.w, Tr);
                    refl = refl * Tr + S;
                } else if (g.extra.x > 0.0) {
                    vec3 Tr = exp(-(vec3(5.8e-6, 13.5e-6, 33.1e-6) + 2.0e-6) * g.extra.x * pl.t);
                    refl = refl * Tr + hazeColor(R) * (1.0 - Tr);
                }
            }
            if (globeWater && cloudsOn()) {
                // the clouds in the reflection (sky or far shore behind them)
                vec4 cr = cloudMarch(p - g.planet.xyz, R, pl.t < 0.0 ? 1e30 : pl.t, 20, rnd(rng));
                refl = refl * cr.a + cr.rgb;
            } else if (!globe() && cloudsOn()) {
                refl = forestClouds(refl, p - g.planet.xyz, R, pl.t, 20, rnd(rng));
            }
            vec3 H = normalize(L - dir);
            float glint = pow(max(dot(nR, H), 0.0), 900.0) * 120.0;
            if (seaFFT) {
                // The sun's glitter: a Beckmann microfacet lobe whose mean square slope is the
                // sea's unresolved slope variance (Cox-Munk): the glitter path widens with the
                // wind as it does over the real sea. (The reflection rays skip the sun disc's
                // share: the lobe carries it.)
                float m2 = max(lostVar, 2e-4);
                float NdH = max(dot(n, H), 1e-3), NdV = max(dot(n, -dir), 1e-3), c2 = NdH * NdH;
                float D = exp((c2 - 1.0) / (c2 * m2)) / (PI * m2 * c2 * c2);
                float Fh = 0.02 + 0.98 * pow(1.0 - max(dot(H, -dir), 0.0), 5.0);
                glint = dot(n, L) > 0.0 ? D * Fh / (4.0 * NdV) / max(F, 1e-3) : 0.0;
            }
            // (a city's narrow channels: the bright hazy sky they mirror is held to a fraction
            // of the sunlight, so a canal near the sun reads as water, not as a white sheet)
            if (g.city.x > 0.5) {
                float rl = dot(refl, vec3(0.2126, 0.7152, 0.0722));
                float capL = 0.12 * g.sunDir.w;
                if (rl > capL) refl *= capL / rl;
            }
            col = mix(col, refl, F) + E * glint * F * sh;
            vec3 foamCol = vec3(0.75) * (E * max(L.y, 0.0) / PI * sh + skyUp);
            col = mix(col, foamCol, foam * 0.6);
            gbN = n;
            gbAlb = mix(vec3(0.02, 0.04, 0.04), vec3(0.75), foam);
            gbRough = 0.05;
            gbSpec = F;
            pl.t = tHit;
        }

        if (dbg == 1u) {
            vec3 c = imp ? ((pl.flags & FLAG_IMPOSTOR_HI) != 0u ? vec3(1.0, 0.62, 0.12) : vec3(0.95, 0.22, 0.20)) : (mat == MAT_TERRAIN ? vec3(0.45) : vec3(0.25, 0.85, 0.35));
            col = c * (0.35 + 0.65 * max(ndl, 0.0) * sh);
        } else if (dbg == 2u) {
            col = n * 0.5 + 0.5;
        } else if (dbg == 3u) {
            col = sqrt(alb) * 1.4;
        } else if (dbg == 4u) {
            col = vec3(ao);
        } else if (dbg == 5u) {
            col = vec3(sh);
        } else if (dbg == 8u) {
            col = transTerm; // leaf transmission only
        } else if (dbg == 9u) {
            col = specTerm * 16.0; // specular only (x16 for measurement)
        } else if (dbg == 11u) {
            col = alb * 4.0 * (0.5 + 0.5 * max(ndl, 0.0)); // ground layer codes (tri.rchit)
        } else if (dbg == 10u) {
            col = alb / PI * E * max(ndl, 0.0) * sh + alb * amb * ao; // diffuse only
        }
    }

    // Aerial perspective: Rayleigh (+ a little aerosol) extinction and in-scattering along the
    // view ray. Clear-day density: distant hills turn blue-grey over tens of kilometres.
    if (pl.t > 0.0 && globe() && dbg == 0u) {
        vec3 T;
        vec3 S = atmosphere(-g.planet.xyz, dir, pl.t, g.sunDir.xyz, g.sunDir.w, T);
        col = col * T + S;
    }
    // The aircraft's condensation trail (aircraft.glsl), behind the clouds.
    if (craftOn() && dbg == 0u) {
        float od = contrailDepth(org, dir, pl.t < 0.0 ? 1e30 : pl.t);
        if (od > 1e-3) col = mix(col, vapourLight(), 1.0 - exp(-od));
    }
    // Clouds in front of whatever the ray found (sky or ground), jittered per pixel and frame.
    if (globe() && dbg == 0u && cloudsOn()) {
        vec4 cl = cloudMarch(-g.planet.xyz, dir, pl.t < 0.0 ? 1e30 : pl.t, 40, rnd(rng));
        col = col * cl.a + cl.rgb;
    } else if (!globe() && dbg == 0u) {
        if (pl.t > 0.0 && g.extra.x > 0.0) {
            // (the forest scene's haze; the globe has its atmosphere above)
            vec3 beta = (vec3(5.8e-6, 13.5e-6, 33.1e-6) + 2.0e-6) * g.extra.x;
            vec3 T = exp(-beta * pl.t);
            col = col * T + hazeColor(dir) * (1.0 - T);
        }
        if (cloudsOn()) col = forestClouds(col, org - g.planet.xyz, dir, pl.t, 40, rnd(rng));
    }
    // The afterburner's flame and the vapour round the aircraft, in front of it all.
    if (craftOn() && dbg == 0u) {
        vec4 cv = craftVolumes(org, dir, pl.t < 0.0 ? 1e30 : pl.t, rnd(rng));
        col = col * cv.a + cv.rgb;
    }
    // This frame's sample and hit distance; taa.comp blends it into the history.
    // eye adaptation before the 16-bit targets (moonlit radiance would flush to zero in them)
    if (globe() && dbg == 0u) col *= g.sunTrue.w;
    imageStore(curImg, ivec2(px), vec4(col, 1.0));
    imageStore(depthImg, ivec2(px), vec4(pl.t < 0.0 ? 10.0 * farRay() : pl.t));
    if (g.lodParams.z > 0.5) {
        // Motion: where this sample's surface point was in the previous frame (unjittered cameras).
        vec4 X = pl.t < 0.0 ? vec4(dir, 0.0) : vec4(org + dir * pl.t, 1.0);
        vec2 sz = vec2(size);
        vec2 cur = projectPx(X, g.camPos, g.camRight, g.camUp, g.camFwd, sz);
        // (the aircraft moves with the camera, not with the land: where this point of it was)
        vec4 Xp = craftHit ? vec4(dot(g.acPrev0.xyz, X.xyz) + g.acPrev0.w, dot(g.acPrev1.xyz, X.xyz) + g.acPrev1.w, dot(g.acPrev2.xyz, X.xyz) + g.acPrev2.w, 1.0) : X;
        vec2 prev = projectPx(Xp, g.prevPos, g.prevRight, g.prevUp, g.prevFwd, sz);
        imageStore(motionImg, ivec2(px), vec4(prev - cur, 0.0, 0.0));
        imageStore(viewzImg, ivec2(px), vec4(pl.t < 0.0 ? 10.0 * farRay() : pl.t * dot(dir, g.camFwd.xyz)));
        imageStore(normalImg, ivec2(px), vec4(gbN, gbRough));
        imageStore(diffImg, ivec2(px), vec4(clamp(gbAlb, 0.0, 1.0), 1.0));
        imageStore(specImg, ivec2(px), vec4(vec3(gbSpec), 1.0));
    }
}
