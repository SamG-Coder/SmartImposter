#version 460
#extension GL_GOOGLE_include_directive : require
#include "shared.glsl"

// Coverage-weighted downsample of the impostor atlases. Empty texels do not drag depth,
// normals, albedo or visibility of covered texels towards zero; coverage itself is averaged.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D srcA;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D srcB;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D dstA;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D dstB;
layout(set = 0, binding = 4, rgba8) uniform readonly image2D srcC;
layout(set = 0, binding = 5, rgba8) uniform writeonly image2D dstC;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(dstA)))) return;

    vec4 aS = vec4(0.0), cS4 = vec4(0.0);
    vec3 nS = vec3(0.0);
    float hS = 0.0, cS = 0.0;
    for (int i = 0; i < 4; ++i) {
        ivec2 q = p * 2 + ivec2(i & 1, i >> 1);
        vec4 a = imageLoad(srcA, q);
        vec4 b = imageLoad(srcB, q);
        vec4 c = imageLoad(srcC, q);
        float w = b.w;
        cS += w;
        aS += a * w;
        cS4 += c * w;
        nS += octDecode(b.xy) * w;
        hS += b.z * w;
    }
    if (cS < 1e-4) {
        imageStore(dstA, p, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(dstB, p, vec4(0.0, 0.0, -1.0, 0.0));
        imageStore(dstC, p, vec4(1.0, 0.5, 0.5, 0.5));
        return;
    }
    imageStore(dstA, p, aS / cS);
    imageStore(dstB, p, vec4(octEncode(normalize(nS)), hS / cS, cS * 0.25));
    // Visibility y = length of the averaged normal: averaging the children's normals shortens it
    // further by their coherence |sum w n| / sum w.
    vec4 vis = cS4 / cS;
    vis.y *= clamp(length(nS) / cS, 0.0, 1.0);
    imageStore(dstC, p, vis);
}
