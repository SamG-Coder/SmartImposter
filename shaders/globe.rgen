#version 460
#extension GL_GOOGLE_include_directive : require
#include "globe.glsl"

// The 1:1 globe: primary rays against the terrain tiles and the impostor trees (impostor.rint /
// impostor.rchit, shared with the forest scene), sun shadows through both, ground-to-orbit
// atmosphere, ocean / lake reflections.
layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImg;
layout(set = 0, binding = 30) uniform GG { GlobeGlobals gg; };

layout(location = 0) rayPayloadEXT HitPayload pl;
layout(location = 1) rayPayloadEXT uint vis;

float traceShadow(vec3 o, vec3 d) {
    vis = 0u;
    traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT | gl_RayFlagsOpaqueEXT,
                0xFF, 0, 0, 1, o, 0.0, d, 2.0e7, 1);
    return float(vis);
}

void main() {
    uvec2 px = gl_LaunchIDEXT.xy;
    vec2 size = vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = (vec2(px) + 0.5) / size * 2.0 - 1.0;
    float th = gg.camFwd.w;
    vec3 rd = normalize(gg.camFwd.xyz + ndc.x * th * (size.x / size.y) * gg.camRight.xyz - ndc.y * th * gg.camUp.xyz);
    vec3 pc = gg.planet.xyz;   // planet centre, camera-relative
    vec3 ro = -pc;             // camera, planet-centre-relative
    vec3 L = gg.sun.xyz;
    float sunI = gg.sun.w;
    uint dbg = uint(gg.params.z);

    pl.t = -1.0;
    pl.sunVis = 1.0;
    pl.shadowMask = 0xFFu;
    pl.trans = vec3(0.0);
    pl.wdepth = 0.0;
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, vec3(0.0), 0.0, rd, 1.0e9, 0);

    vec3 col;
    if (pl.t < 0.0) {
        vec3 T;
        col = atmosphere(ro, rd, 1e30, L, sunI, T);
        if (dot(rd, L) > 0.99996 && raySphere(ro, rd, R_GROUND).x < 0.0) col += sunI * 2000.0 * T;
    } else {
        vec3 p = rd * pl.t;
        vec3 q = p - pc;
        vec3 up = normalize(q);
        bool imp = (pl.flags & FLAG_IMPOSTOR) != 0u;
        bool leaf = (pl.flags & 0xFFu) == MAT_LEAF;
        bool water = (pl.flags & FLAG_WATER) != 0u;
        vec3 n = pl.n, ng = pl.ng;
        if (dot(ng, rd) > 0.0) ng = -ng;
        if (imp && dot(n, rd) > 0.0) n = -n;
        float nLen = max(length(n), 1e-4);
        vec3 nDir = n / nLen;
        vec3 alb = pl.albedo;
        float ndl = dot(n, L);
        float side = dot(ng, L) >= 0.0 ? 1.0 : -1.0;
        vec3 so = imp ? p + L * (0.05 + pl.t * 2e-4) : p + up * (0.3 + pl.t * 2e-5);
        float sh = (ndl > 0.0 || leaf) ? traceShadow(so, L) * pl.sunVis : 0.0;
        vec3 Esun = sunI * extinction(lightDepth(q, L));
        // sky light: the zenith sky radiance over the hemisphere (cheap stand-in for irradiance)
        vec3 Tz;
        vec3 skyZ = atmosphere(q, up, 1e30, L, sunI, Tz);
        vec3 amb = skyZ * PI * (0.6 + 0.4 * dot(nDir, up));
        col = alb / PI * Esun * max(ndl, 0.0) * sh + alb * amb * pl.ao;
        if (leaf) {
            // leaf transmission (as main.rgen): impostors spread it over the crown
            float transW = imp ? 0.25 * (1.0 - dot(nDir, L)) : max(-ndl, 0.0);
            col += pl.trans * 2.0 / PI * Esun * transW * sh;
        }
        if (water) {
            vec3 R = reflect(rd, n);
            float cosT = max(dot(-rd, n), 0.0);
            float F = 0.02 + 0.98 * pow(1.0 - cosT, 5.0);
            vec3 Tr;
            vec3 refl = atmosphere(q, normalize(vec3(R + up * max(0.0, 0.01 - dot(R, up)))), 1e30, L, sunI, Tr);
            float glint = pow(max(dot(R, L), 0.0), 1500.0) * 400.0;
            col = mix(col, refl, F) + Esun * glint * F * sh;
        }
        if (dbg == 1u) col = (nDir * 0.5 + 0.5) * 0.3;
        if (dbg >= 2u) col = alb * 0.3;
        // aerial perspective
        vec3 T;
        vec3 S = atmosphere(ro, rd, pl.t, L, sunI, T);
        col = col * T + S;
    }
    col *= gg.params.x;
    imageStore(outImg, ivec2(px), vec4(tonemap(col), 1.0));
}
