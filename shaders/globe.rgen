#version 460
#extension GL_GOOGLE_include_directive : require
#include "globe.glsl"

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outImg;
layout(set = 0, binding = 2) uniform GG { GlobeGlobals gg; };
layout(set = 0, binding = 4) uniform sampler2D elevTex; // ETOPO 2022 60", R16_SNORM metres / 32767

// Elevation (m) at a direction from the planet centre, at a mip for the pixel footprint (m).
const float TEXEL_M = 1853.0; // one arc-minute on the equator
vec2 elevUV(vec3 up) {
    float lat = asin(clamp(up.z, -1.0, 1.0));
    float lon = atan(up.y, up.x);
    return vec2(lon / (2.0 * PI) + 0.5, 0.5 - lat / PI);
}
float elevAt(vec2 uv, float lod) { return textureLod(elevTex, uv, lod).r * 32767.0; }

layout(location = 0) rayPayloadEXT GlobePayload pl;
layout(location = 1) rayPayloadEXT uint vis;

float traceShadow(vec3 o, vec3 d) {
    vis = 0u;
    traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT | gl_RayFlagsOpaqueEXT,
                0xFF, 0, 0, 1, o, 0.0, d, 2.0e7, 1);
    return float(vis);
}

// Land colour until the land-cover data arrives (milestone 3: ESA WorldCover + RESOLVE biomes):
// a neutral stand-in from latitude and elevation only, so the relief can be judged.
vec3 landAlbedo(float lat, float elev, float slope) {
    float a = abs(lat);
    vec3 c = vec3(0.06, 0.08, 0.045);
    c = mix(c, vec3(0.24, 0.20, 0.14), smoothstep(14.0, 22.0, a) * (1.0 - smoothstep(32.0, 40.0, a)));
    c = mix(c, vec3(0.05, 0.065, 0.04), smoothstep(52.0, 58.0, a));
    c = mix(c, vec3(0.12, 0.11, 0.09), smoothstep(64.0, 70.0, a));
    c = mix(c, vec3(0.14, 0.13, 0.12), smoothstep(0.2, 0.45, slope));
    // ice sheets (Antarctica, Greenland) and snow on the high mountains
    float snowline = mix(5800.0, 600.0, smoothstep(30.0, 70.0, a));
    float ice = max(smoothstep(snowline, snowline + 500.0, elev) * (1.0 - smoothstep(0.35, 0.6, slope)),
                    smoothstep(62.0, 70.0, a) * smoothstep(800.0, 1500.0, elev));
    ice = max(ice, smoothstep(-64.0, -66.0, lat) * step(1.0, elev));
    return mix(c, vec3(0.78, 0.8, 0.84), ice);
}

void main() {
    uvec2 px = gl_LaunchIDEXT.xy;
    vec2 size = vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = (vec2(px) + 0.5) / size * 2.0 - 1.0;
    float th = gg.camFwd.w;
    vec3 rd = normalize(gg.camFwd.xyz + ndc.x * th * (size.x / size.y) * gg.camRight.xyz - ndc.y * th * gg.camUp.xyz);
    vec3 pc = gg.planet.xyz;   // planet centre, camera-relative
    vec3 ro = -pc;             // camera, planet-centre-relative
    vec3 L = gg.sun.xyz;
    float sunI = gg.sun.w;
    uint dbg = uint(gg.params.z);

    pl.t = -1.0;
    traceRayEXT(tlas, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, vec3(0.0), 0.0, rd, 1.0e9, 0);

    vec3 col;
    if (pl.t < 0.0) {
        vec3 T;
        col = atmosphere(ro, rd, 1e30, L, sunI, T);
        // sun disc (if the planet does not block it)
        if (dot(rd, L) > 0.99996 && raySphere(ro, rd, R_GROUND).x < 0.0) col += sunI * 2000.0 * T;
        // stars-free black space beyond
    } else {
        vec3 p = rd * pl.t;
        vec3 q = p - pc;
        vec3 up = normalize(q);
        float lat = degrees(asin(clamp(up.z, -1.0, 1.0)));
        vec3 n = pl.n;
        if (dot(n, up) < 0.0) n = -n;
        bool water = pl.water > 0.5;
        // Where the tile mesh is coarser than the data (far away), coastline and relief come from
        // the elevation grid per pixel instead (geometry cells ~ t / 160 m, see tiles.rs SPLIT_K).
        float pixelAngle = 2.0 * gg.camFwd.w / size.y;
        float footprint = pl.t * pixelAngle;
        float cell = pl.t / 160.0;
        float wTex = smoothstep(0.7, 2.0, cell / TEXEL_M);
        if (wTex > 0.0) {
            float coslat = max(sqrt(1.0 - up.z * up.z), 0.02);
            float lod = max(log2(footprint / (TEXEL_M * coslat)), 0.0);
            vec2 uv = elevUV(up);
            vec2 texel = vec2(1.0 / 21600.0, 1.0 / 10800.0) * exp2(lod);
            float h0 = elevAt(uv, lod);
            float hE = elevAt(uv + vec2(texel.x, 0.0), lod), hW = elevAt(uv - vec2(texel.x, 0.0), lod);
            float hN = elevAt(uv - vec2(0.0, texel.y), lod), hS = elevAt(uv + vec2(0.0, texel.y), lod);
            vec3 east = normalize(cross(vec3(0.0, 0.0, 1.0), up));
            vec3 north = cross(up, east);
            float dx = 2.0 * texel.x * 2.0 * PI * R_GROUND * coslat;
            float dy = 2.0 * texel.y * PI * R_GROUND;
            vec3 nt = normalize(up - east * max(hE, 0.0) / dx + east * max(hW, 0.0) / dx - north * max(hN, 0.0) / dy + north * max(hS, 0.0) / dy);
            n = normalize(mix(n, nt, wTex));
            if (wTex > 0.5) water = h0 < 0.0;
            pl.elev = mix(pl.elev, h0, wTex);
        }
        if (water) n = up;
        float slope = 1.0 - max(dot(n, up), 0.0);
        vec3 alb = water ? mix(vec3(0.02, 0.06, 0.07), vec3(0.004, 0.014, 0.03), smoothstep(10.0, 300.0, -pl.elev))
                         : landAlbedo(lat, pl.elev, slope);

        float ndl = dot(n, L);
        float sh = ndl > 0.0 ? traceShadow(p + up * (1.0 + pl.t * 2e-5), L) : 0.0;
        vec3 sunT = extinction(lightDepth(q, L));
        vec3 Esun = sunI * sunT;
        // sky light: the zenith sky radiance over the hemisphere (cheap stand-in for irradiance)
        vec3 Tz;
        vec3 skyZ = atmosphere(q, up, 1e30, L, sunI, Tz);
        vec3 amb = skyZ * PI * (0.6 + 0.4 * dot(n, up));
        col = alb / PI * Esun * max(ndl, 0.0) * sh + alb * amb;
        if (water) {
            vec3 R = reflect(rd, n);
            float cosT = max(dot(-rd, n), 0.0);
            float F = 0.02 + 0.98 * pow(1.0 - cosT, 5.0);
            vec3 Tr;
            vec3 refl = atmosphere(q, normalize(vec3(R + up * max(0.0, 0.01 - dot(R, up)))), 1e30, L, sunI, Tr);
            float glint = pow(max(dot(R, L), 0.0), 1500.0) * 400.0;
            col = mix(col, refl, F) + Esun * glint * F * sh;
        }
        if (dbg == 1u) col = (n * 0.5 + 0.5) * 0.3;
        if (dbg == 2u) col = vec3(fract(pl.elev / 500.0), clamp(pl.elev / 5000.0, 0.0, 1.0), pl.water) * 0.3;
        // aerial perspective
        vec3 T;
        vec3 S = atmosphere(ro, rd, pl.t, L, sunI, T);
        col = col * T + S;
    }
    col *= gg.params.x;
    imageStore(outImg, ivec2(px), vec4(tonemap(col), 1.0));
}
