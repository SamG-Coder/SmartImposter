#version 460
#extension GL_GOOGLE_include_directive : require
#include "rt.glsl"

// Impostor baker. Each launch (x, y, z) is one texel of one hemi-octahedral frame.
// Orthographic rays are traced against a TLAS that contains only the full-detail tree
// (every twig instance), so the atlas is captured with the same RT hardware used at runtime.
// Outputs per texel:
//   albedo atlas (rgba8):   sqrt(albedo).rgb, ray traced ambient occlusion
//   normal/depth (rgba16f): octahedral normal (object space), depth along the frame, coverage

layout(set = 0, binding = 0) uniform accelerationStructureEXT tlas;
layout(set = 0, binding = 8, rgba8) uniform writeonly image2D bakeAlbedo;
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D bakeND;
layout(set = 0, binding = 10, rgba8) uniform writeonly image2D bakeVis;

layout(push_constant) uniform BakePC {
    vec4 centerRadius;
    uint grid;
    uint res;
    uint frameOffset;
    uint ss;
    uint aoRays;
    float aoRange;
    uint visRays;
    uint pad1;
    uvec2 size;   // texels of a frame (across, up): the square frame of `res` texels cropped
    uvec2 crop;   // its first texel in the square frame
} pc;

vec3 uniformSphere(inout uint s) {
    float z = 1.0 - 2.0 * rnd(s);
    float r = sqrt(max(0.0, 1.0 - z * z));
    float phi = 6.2831853 * rnd(s);
    return vec3(r * cos(phi), z, r * sin(phi));
}

layout(location = 0) rayPayloadEXT HitPayload pl;
layout(location = 1) rayPayloadEXT uint vis;

// The lawn tile (src/lawn.rs; pad1 = 1 | gutter texels << 8): centerRadius = tile edge, blade
// height, slope of the steepest and the flattest views; crop = views (azimuths, slopes); res =
// texels per view. The atlas is a grid of blocks of views (size texels each), a view at
// (azimuth, slope) x res. Texel (u, v) of a view from f is the line along f through the point
// (u, v) of the plane of the blade tips (the tile is baked between copies of itself, and the
// gutter texels lie over the neighbouring copies: the views wrap). Stored: the height of the
// first blade on the line (0 ground .. 1 tips, as depth), its colour, normal and coverage; how
// much of the sky it sees.
void bakeLawn(uvec2 block) {
    float T = pc.centerRadius.x, H = pc.centerRadius.y, gut = float(pc.pad1 >> 8);
    uvec2 at = block * pc.size + gl_LaunchIDEXT.xy; // texel of the atlas
    uvec2 cell = at / pc.res, px = at % pc.res;
    vec3 f = lawnFrameDir(vec2(cell), vec2(pc.crop), pc.centerRadius.zw);
    float tile = float(pc.res) - 2.0 * gut;
    uint rng = hash2(px + cell * pc.res) ^ 0x51u;
    uint hits = 0u;
    vec3 alb = vec3(0.0), nsum = vec3(0.0);
    float hsum = 0.0, aosum = 0.0, vaSum = 0.0, skySum = 0.0;
    for (uint sy = 0u; sy < pc.ss; ++sy)
    for (uint sx = 0u; sx < pc.ss; ++sx) {
        vec2 uv = (vec2(px) + (vec2(sx, sy) + 0.5) / float(pc.ss) - gut) / tile;
        // from a little above the tips down to the ground
        vec3 o = vec3(uv.x * T, H, uv.y * T) + f * (0.04 * H / f.y);
        pl.t = -1.0;
        traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, o, 0.0, -f, 1.04 * H / f.y, 0);
        if (pl.t < 0.0) continue;
        hits++;
        alb += pl.albedo;
        vec3 n = dot(pl.n, f) < 0.0 ? -pl.n : pl.n;
        vec3 ng = dot(pl.ng, f) < 0.0 ? -pl.ng : pl.ng;
        nsum += n;
        vec3 p = o - f * pl.t;
        hsum += clamp(p.y / H, 0.0, 1.0);
        // occlusion by the blades around; the ground closes the lower half
        float occ = 0.0;
        for (uint a = 0u; a < pc.aoRays; ++a) {
            vec3 d2 = cosineSample(n, rng);
            if (d2.y <= 0.0) { occ += 1.0; continue; }
            vis = 0u;
            traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                        0xFF, 0, 0, 1, p + ng * 0.0004, 0.0, d2, pc.aoRange, 1);
            occ += 1.0 - float(vis);
        }
        aosum += 1.0 - occ / float(max(pc.aoRays, 1u));
        // sky: the fraction of the upper hemisphere seen, plain and weighted by the cosine
        float va = 0.0, sky = 0.0;
        for (uint k = 0u; k < pc.visRays; ++k) {
            vec3 dir = uniformSphere(rng);
            dir.y = abs(dir.y) + 1e-3;
            float side = dot(ng, dir) >= 0.0 ? 1.0 : -1.0;
            vis = 0u;
            traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                        0xFF, 0, 0, 1, p + ng * side * 0.0004, 0.0, dir, (H - p.y) / dir.y + 0.01, 1);
            va += float(vis);
            sky += float(vis) * dir.y * 2.0;
        }
        float invV = 1.0 / float(max(pc.visRays, 1u));
        vaSum += va * invV;
        skySum += sky * invV;
    }
    ivec2 texel = ivec2(at);
    if (hits == 0u) {
        imageStore(bakeAlbedo, texel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(bakeND, texel, vec4(0.0, 0.0, -1.0, 0.0));
        imageStore(bakeVis, texel, vec4(1.0, 0.5, 0.5, 0.5));
        return;
    }
    float inv = 1.0 / float(hits);
    imageStore(bakeAlbedo, texel, vec4(sqrt(alb * inv), aosum * inv));
    imageStore(bakeND, texel, vec4(octEncode(normalize(nsum)), hsum * inv * 2.0 - 1.0, float(hits) / float(pc.ss * pc.ss)));
    // x: sky seen (plain), y: normal spread, z: sky seen (cosine-weighted: the ambient light)
    imageStore(bakeVis, texel, vec4(vaSum * inv, clamp(length(nsum) * inv, 0.0, 1.0), clamp(skySum * inv, 0.0, 1.0), 0.5));
}

void main() {
    uint fi = pc.frameOffset + gl_LaunchIDEXT.z;
    if (fi >= pc.grid * pc.grid) return;
    uvec2 cell = uvec2(fi % pc.grid, fi / pc.grid);
    if ((pc.pad1 & 1u) != 0u) {
        bakeLawn(cell);
        return;
    }
    // The frame is the square view of the bounding sphere (res x res texels) cropped to the
    // plant: px is the texel in that square, so the rays, and their random numbers, are those of
    // the uncropped bake.
    uvec2 px = gl_LaunchIDEXT.xy + pc.crop;

    vec3 c = pc.centerRadius.xyz;
    float R = pc.centerRadius.w;
    vec3 f = frameDir(vec2(cell), float(pc.grid));
    vec3 r, u;
    frameBasis(f, r, u);

    uint rng = hash2(px + cell * pc.res);
    uint hits = 0u;
    vec3 alb = vec3(0.0), nsum = vec3(0.0);
    float hsum = 0.0, aosum = 0.0;
    float vaSum = 0.0;  // directional self-visibility, linear fit: V(L) = a + b . L
    vec3 vbSum = vec3(0.0);

    for (uint sy = 0u; sy < pc.ss; ++sy)
    for (uint sx = 0u; sx < pc.ss; ++sx) {
        vec2 uv = (vec2(px) + (vec2(sx, sy) + 0.5) / float(pc.ss)) / float(pc.res);
        vec3 o = c + r * ((uv.x - 0.5) * 2.0 * R) + u * ((uv.y - 0.5) * 2.0 * R) + f * (1.05 * R);
        pl.t = -1.0;
        traceRayEXT(tlas, gl_RayFlagsNoneEXT, 0xFF, 0, 0, 0, o, 0.0, -f, 2.1 * R, 0); // not opaque: alpha-tested cards run tri.rahit
        if (pl.t < 0.0) continue;

        hits++;
        alb += pl.albedo;
        vec3 n = dot(pl.n, f) < 0.0 ? -pl.n : pl.n;
        vec3 ng = dot(pl.ng, f) < 0.0 ? -pl.ng : pl.ng;
        nsum += n;
        hsum += 1.05 - pl.t / R;

        vec3 p = o - f * pl.t;
        float occ = 0.0;
        for (uint a = 0u; a < pc.aoRays; ++a) {
            vec3 d2 = cosineSample(n, rng);
            vis = 0u;
            traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                        0xFF, 0, 0, 1, p + ng * 0.003, 0.0, d2, pc.aoRange, 1);
            occ += 1.0 - float(vis);
        }
        aosum += (1.0 - occ / float(max(pc.aoRays, 1u))) * pl.ao; // traced AO x material AO (bark texture)

        // Self-shadowing in every direction through the whole tree (sun can move, trees are rotated).
        float va = 0.0;
        vec3 vb = vec3(0.0);
        for (uint k = 0u; k < pc.visRays; ++k) {
            vec3 dir = uniformSphere(rng);
            float side = dot(ng, dir) >= 0.0 ? 1.0 : -1.0;
            vis = 0u;
            traceRayEXT(tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                        0xFF, 0, 0, 1, p + ng * side * 0.003, 0.0, dir, 2.2 * R, 1);
            va += float(vis);
            vb += float(vis) * dir;
        }
        float invV = 1.0 / float(max(pc.visRays, 1u));
        vaSum += va * invV;
        vbSum += vb * (3.0 * invV);
    }

    ivec2 texel = ivec2(cell * pc.size + gl_LaunchIDEXT.xy);
    if (hits == 0u) {
        imageStore(bakeAlbedo, texel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(bakeND, texel, vec4(0.0, 0.0, -1.0, 0.0));
        imageStore(bakeVis, texel, vec4(1.0, 0.5, 0.5, 0.5));
        return;
    }
    float inv = 1.0 / float(hits);
    imageStore(bakeAlbedo, texel, vec4(sqrt(alb * inv), aosum * inv));
    imageStore(bakeND, texel, vec4(octEncode(normalize(nsum)), hsum * inv, float(hits) / float(pc.ss * pc.ss)));
    // Visibility atlas: x = a, z = b.y (up: sky occlusion). y = length of the averaged normal
    // (normal spread: 1 = flat surface, ~0.5 = blades in all directions; Lambert over the texel is
    // |mean n| * max(dot(mean n^, L), 0)). w = b.z (unused).
    vec3 vb = clamp(vbSum * inv / 3.0 + 0.5, 0.0, 1.0);
    imageStore(bakeVis, texel, vec4(vaSum * inv, clamp(length(nsum) * inv, 0.0, 1.0), vb.y, vb.z));
}
